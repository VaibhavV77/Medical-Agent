   "source": [
    "from neo4j import GraphDatabase\n",
    "from sentence_transformers import SentenceTransformer\n",
    "\n",
    "NEO4J_URI= \"neo4j+s://eda8932b.databases.neo4j.io\"\n",
    "NEO4J_USER = \"eda8932b\"\n",
    "NEO4J_PASSWORD = \""\n",
    "\n",
    "NODE_LABEL = \"Document\"\n",
    "TEXT_PROPERTY = \"text\"\n",
    "EMBEDDING_PROPERTY = \"embedding\"\n",
    "BATCH_SIZE = 500\n",
    "\n",
    "print(\"Loading PubMedBERT model...\")\n",
    "model = SentenceTransformer('NeuML/pubmedbert-base-embeddings')\n",
    "\n",
    "def process_embeddings(tx):\n",
    "    print(f\"Fetching {NODE_LABEL} nodes without embeddings...\")\n",
    "    fetch_query = f\"\"\"\n",
    "        MATCH (n:{NODE_LABEL})\n",
    "        WHERE n.{TEXT_PROPERTY} IS NOT NULL AND n.{EMBEDDING_PROPERTY} IS NULL\n",
    "        RETURN elementId(n) AS id, n.{TEXT_PROPERTY} AS text\n",
    "    \"\"\"\n",
    "    result = tx.run(fetch_query)\n",
    "    records = [record for record in result]\n",
    "    \n",
    "    if not records:\n",
    "        print(\"No new nodes to process.\")\n",
    "        return\n",
    "\n",
    "    print(f\"Found {len(records)} nodes. Generating biomedical embeddings...\")\n",
    "    \n",
    "    for i in range(0, len(records), BATCH_SIZE):\n",
    "        batch = records[i:i + BATCH_SIZE]\n",
    "        texts = [record[\"text\"] for record in batch]\n",
    "        embeddings = model.encode(texts)\n",
    "        \n",
    "        update_data = [\n",
    "            {\"id\": record[\"id\"], \"embedding\": emb.tolist()} \n",
    "            for record, emb in zip(batch, embeddings)\n",
    "        ]\n",
    "        \n",
    "        update_query = f\"\"\"\n",
    "            UNWIND $data AS row\n",
    "            MATCH (n) WHERE elementId(n) = row.id\n",
    "            SET n.{EMBEDDING_PROPERTY} = row.embedding\n",
    "        \"\"\"\n",
    "        tx.run(update_query, data=update_data)\n",
    "        print(f\"Processed and stored batch {i//BATCH_SIZE + 1} ({len(batch)} nodes)\")\n",
    "\n",
    "if __name__ == \"__main__\":\n",
    "    driver = GraphDatabase.driver(NEO4J_URI, auth=(NEO4J_USER, NEO4J_PASSWORD))\n",
    "    try:\n",
    "        with driver.session() as session:\n",
    "            session.execute_write(process_embeddings)\n",
    "        print(\"Biomedical embedding generation complete!\")\n",
    "    except Exception as e:\n",
    "        print(f\"An error occurred: {e}\")\n",
    "    finally:\n",
    "        driver.close()"
   ]
  }
